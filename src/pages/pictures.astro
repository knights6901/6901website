---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Photos | FRC 6901 KnightFall"
  description="Photo gallery from FRC 6901 KnightFall. Seasons, competitions, and memories."
  currentPage="pictures"
>
  <link slot="head" rel="stylesheet" href="/css/pictures.css?v=7">

  <!-- PAGE HERO -->
  <div class="page-hero" id="gallery-top">
    <div class="page-hero-bg"></div>
    <img class="page-hero-photo" src="/images/photo_gallery/2026match.avif" alt="" fetchpriority="high">
    <div class="page-hero-inner">
      <div class="page-eyebrow">Gallery</div>
      <h1 class="page-title">Achievements<br>& <em>Memories</em></h1>
      <p class="page-desc">A look back at the seasons, competitions, and moments that define KnightFall.</p>
    </div>
  </div>

  <!-- FILTER BAR -->
  <div class="filter-bar" role="group" aria-label="Filter photos by season">
    <button class="filter-btn active" data-year="all"     aria-pressed="true" aria-controls="gallery-grid">All Photos</button>
    <button class="filter-btn"        data-year="2026"    aria-pressed="false" aria-controls="gallery-grid">2026 Season</button>
    <button class="filter-btn"        data-year="2025"    aria-pressed="false" aria-controls="gallery-grid">2025 Season</button>
    <button class="filter-btn"        data-year="2024"    aria-pressed="false" aria-controls="gallery-grid">2024 Season</button>
    <button class="filter-btn"        data-year="2023"    aria-pressed="false" aria-controls="gallery-grid">2023 Season</button>
    <button class="filter-btn"        data-year="history" aria-pressed="false" aria-controls="gallery-grid">2018 – 2022</button>
  </div>

  <!-- GALLERY (populated by JS) -->
  <div class="gallery-section" aria-label="KnightFall photo archive">
    <div class="gallery-grid" id="gallery-grid"></div>
    <p class="gallery-status" id="gallery-status" aria-live="polite"></p>
  </div>

  <!-- LIGHTBOX -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo lightbox" aria-hidden="true">
    <button class="lb-close" type="button" aria-label="Close photo lightbox">&times;</button>
    <button class="lb-nav lb-prev" type="button" aria-label="Previous photo">&#8592;</button>
    <img class="lb-img" id="lb-img" src="/images/photo_gallery/IMG_3660.avif" alt="">
    <button class="lb-nav lb-next" type="button" aria-label="Next photo">&#8594;</button>
    <div class="lb-caption" id="lb-caption" aria-live="polite"></div>
    <div class="lb-count"   id="lb-count"></div>
  </div>

  <script is:inline slot="scripts" src="/js/pictures.js?v=5"></script>
</BaseLayout>
