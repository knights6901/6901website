---
import BaseLayout from '../layouts/BaseLayout.astro';

const sponsors = [
  { name: 'Boeing', logo: '/images/partner_logos/boeing.png', width: 470, height: 107 },
  { name: 'Leidos', logo: '/images/partner_logos/leidos.png', width: 2525, height: 689 },
  { name: 'Dallas College', logo: '/images/partner_logos/dallascollege.png', width: 640, height: 207 },
  { name: "Raising Cane's", logo: '/images/partner_logos/raisingcanes.png', width: 769, height: 325 },
];
---

<BaseLayout
  title="KnightFall FRC 6901 | Student-Built Robotics"
  description="Meet KnightFall FRC Team 6901, explore our student-built competition robot, and learn how to join or support the team in Frisco, Texas."
  keywords="FRC, 6901 KnightFall, robotics, STEM, Frisco Texas, student robotics"
  currentPage="home"
>
  <link slot="head" rel="stylesheet" href="/css/index.css?v=55">
  <script is:inline slot="head">
    self.ModelViewerElement = self.ModelViewerElement || {};
    self.ModelViewerElement.dracoDecoderLocation = '/draco/';
  </script>

  <div class="site-loader" id="site-loader" role="status" aria-live="polite" aria-label="Loading KnightFall">
    <div class="loader-signature">
      <div class="loader-mark" aria-hidden="true">
        <svg class="loader-mark-trace" viewBox="0 0 500 500" role="presentation">
          <path class="loader-ink loader-ink-pommel" pathLength="1" d="M250 18 283 51 250 84 217 51 250 18Z" />
          <path class="loader-ink loader-ink-stem" pathLength="1" d="M250 84V136" />
          <path class="loader-ink loader-ink-guard" pathLength="1" d="M168 136 190 176H238M210 136H290M332 136 311 176H264" />
          <path class="loader-ink loader-ink-blade" pathLength="1" d="M246 176 213 215 294 383 250 475 210 414 238 353" />
          <path class="loader-ink loader-ink-ribbon" pathLength="1" d="M268 180 295 216 269 263" />
        </svg>
        <img class="loader-mark-final" src="/images/6901_logos/SwordLogo.png" alt="" width="144" height="144">
      </div>
      <div class="loader-type">
        <p class="loader-wordmark" aria-hidden="true"><span class="loader-knight">Knight</span><span class="loader-fall">Fall</span></p>
        <p class="loader-status">Bringing Lancelot online</p>
      </div>
    </div>
  </div>

  <main>
    <section class="robot-story" id="robot" aria-labelledby="home-title">
      <div class="robot-stage" data-phase="hero" data-focus="full">
        <div class="stage-grid" aria-hidden="true"></div>
        <div class="stage-measure stage-measure-top" aria-hidden="true"><span>6901 / LANCELOT</span><span>BUILT BY STUDENTS</span></div>
        <div class="stage-measure stage-measure-side" aria-hidden="true">FRISCO / TEXAS</div>
        <div class="robot-number" aria-hidden="true">6901</div>
        <div class="stage-object stage-spec-sheet" aria-hidden="true">
          <span>System map</span>
          <strong>Intake / Indexer<br>Chassis / Shooter</strong>
          <i></i><i></i><i></i>
        </div>
        <div class="stage-object stage-machined-plate" aria-hidden="true">
          <img src="/images/6901_logos/SwordLogo.png" alt="" width="96" height="96">
          <span>KF / 6901</span>
        </div>
        <div class="stage-object stage-purple-rail" aria-hidden="true"><span>KNIGHTFALL</span></div>
        <div class="stage-light-sweep" aria-hidden="true"></div>

        <div class="hero-copy" id="hero-copy">
          <p class="hero-eyebrow">FRC Team 6901 / Frisco, Texas</p>
          <p class="hero-brand">KnightFall</p>
          <h1 id="home-title">Built by students. <span class="electric-word">Ready</span> for the field.</h1>
          <p class="hero-summary">We’re KnightFall, FRC Team 6901 from Frisco. Students design, machine, wire, program, and drive one competition robot together.</p>
          <div class="hero-actions">
            <a href="/team" class="btn btn-primary">Meet KnightFall <span aria-hidden="true">↗</span></a>
            <a href="https://www.instagram.com/frc6901/" target="_blank" rel="noopener" class="btn btn-ghost">Instagram <span aria-hidden="true">↗</span></a>
          </div>
          <a class="skip-robot" href="#join">Skip the robot story</a>
        </div>

        <div class="robot-viewer-wrap">
          <div class="robot-aura" aria-hidden="true"></div>
          <div class="robot-plinth" aria-hidden="true"></div>
          <model-viewer
            id="lancelot-model"
            src="/models/lancelot-display-fast.glb?v=1"
            alt="A 3D model of Lancelot, KnightFall FRC Team 6901's competition robot"
            camera-orbit="115deg 69deg 80%"
            camera-target="auto auto auto"
            orientation="0deg -90deg 0deg"
            field-of-view="30deg"
            environment-image="neutral"
            shadow-intensity="0.52"
            shadow-softness="0.9"
            exposure="0.98"
            tone-mapping="neutral"
            interaction-prompt="none"
            loading="eager"
            reveal="auto"
            disable-zoom
            disable-pan
            tabindex="-1"
          ></model-viewer>
          <p class="model-status" id="model-status" aria-live="polite">Loading the 3D robot…</p>
        </div>

        <aside class="robot-callouts" aria-label="Lancelot robot inspection">
          <article class="robot-callout is-active" data-robot-callout data-robot-group="Full">
            <p class="robot-callout-label"><span>00</span> Meet Lancelot / 360 view</p>
            <p>Lancelot stays fully assembled for one complete orbit before the subsystem inspection begins.</p>
          </article>
          <article class="robot-callout" data-robot-callout data-robot-group="Intake">
            <p class="robot-callout-label"><span>01</span> Intake</p>
            <p>Paired rollers, pulleys, and belt runs form the assembly at the robot's entry.</p>
          </article>
          <article class="robot-callout" data-robot-callout data-robot-group="Indexer">
            <p class="robot-callout-label"><span>02</span> Indexer</p>
            <p>A compact belt-and-shaft path sits between the intake and the upper roller bank.</p>
          </article>
          <article class="robot-callout" data-robot-callout data-robot-group="Shooter">
            <p class="robot-callout-label"><span>03</span> Shooter</p>
            <p>The named shooter assembly contains the large roller bank and belt-driven shafts.</p>
          </article>
          <article class="robot-callout" data-robot-callout data-robot-group="Chassis">
            <p class="robot-callout-label"><span>04</span> Chassis</p>
            <p>Four Thrifty Swerve modules sit inside the aluminum frame.</p>
          </article>
        </aside>

        <div class="robot-progress" aria-hidden="true"><span id="robot-progress-bar"></span></div>
      </div>
    </section>

    <section class="join-section" id="join" aria-labelledby="join-title">
      <div class="join-copy reveal-right">
        <p class="chapter-index">Built for students</p>
        <h2 id="join-title">Find your place in the build.</h2>
        <p>KnightFall is a high school FRC team where students learn CAD, programming, machining, strategy, and leadership by working on one robot together.</p>
        <a href="/team#contact" class="btn btn-primary">Talk with the team <span aria-hidden="true">↗</span></a>
      </div>

      <div class="join-worktable reveal-left" aria-label="Student opportunities">
        <div class="worktable-shadow" aria-hidden="true"></div>
        <div class="worktable-surface" aria-hidden="true"></div>
        <figure class="worktable-photo worktable-photo-main">
          <img src="/images/photo_gallery/robot2.webp" alt="A KnightFall student programming Team 6901's robot beside its exposed wiring and aluminum frame" width="1584" height="2112" loading="lazy" decoding="async">
          <figcaption>Code meets hardware <span>Student built</span></figcaption>
        </figure>
        <figure class="worktable-photo worktable-photo-detail">
          <img src="/images/photo_gallery/programming.avif" alt="KnightFall students working together on robot code" width="640" height="427" loading="lazy" decoding="async">
        </figure>
        <figure class="worktable-photo worktable-photo-build">
          <img src="/images/photo_gallery/2026pitcrew.avif" alt="KnightFall students working together beside tools and robot electronics" width="426" height="640" loading="lazy" decoding="async">
          <figcaption>Build together</figcaption>
        </figure>
        <div class="worktable-word worktable-word-cad" aria-hidden="true">CAD</div>
        <div class="worktable-word worktable-word-build" aria-hidden="true">BUILD</div>
        <ul class="discipline-list" id="student-paths" aria-label="Ways students contribute">
          <li>Design and CAD</li>
          <li>Fabrication</li>
          <li>Programming</li>
          <li>Drive and strategy</li>
        </ul>
      </div>
    </section>

    <section class="proof-moment" aria-labelledby="proof-title">
      <div class="proof-image reveal-left">
        <img src="/images/photo_gallery/2026match.avif" alt="KnightFall competing at a 2026 robotics match" width="640" height="427" loading="lazy" decoding="async">
        <div class="proof-panels" aria-hidden="true">
          <span></span><span></span><span></span>
        </div>
        <div class="proof-ghost-number" aria-hidden="true">2018</div>
      </div>
      <div class="proof-copy reveal-right">
        <p class="track-label" id="proof-title">Field record</p>
        <p class="proof-lede">One student-built program, in motion since 2018.</p>
        <dl class="proof-facts">
          <div><dt>2018</dt><dd>Team founded</dd></div>
          <div><dt>Worlds</dt><dd>Championship qualifier</dd></div>
          <div><dt>Texas</dt><dd>State championship competitor</dd></div>
        </dl>
      </div>
    </section>

    <section class="sponsor-section" id="sponsors" aria-labelledby="sponsor-title">
      <div class="sponsor-intro reveal">
        <p class="chapter-index">Current partners</p>
        <h2 id="sponsor-title">Support the next build.</h2>
        <p>Sponsors help students access parts, tools, travel, and the hands-on experience that makes this program possible.</p>
        <a href="/team#packages" class="btn btn-ghost">View partnership packages <span aria-hidden="true">↗</span></a>
      </div>
      <div class="sponsor-ribbon reveal" aria-label="KnightFall sponsors">
        <div class="sponsor-connector" aria-hidden="true"></div>
        <div class="ribbon-material ribbon-material-purple" aria-hidden="true"></div>
        <div class="ribbon-material ribbon-material-metal" aria-hidden="true"></div>
        <div class="ribbon-material ribbon-material-rubber" aria-hidden="true"></div>
        {sponsors.map((sponsor, index) => (
          <article class="home-sponsor" style={`--sponsor-index: ${index}`}>
            <span class="sponsor-number" aria-hidden="true">0{index + 1}</span>
            <div class="sponsor-plate"><img src={sponsor.logo} alt={sponsor.name} width={sponsor.width} height={sponsor.height} loading="lazy" decoding="async"></div>
          </article>
        ))}
      </div>
    </section>

    <section class="closing-photo reveal-scale" aria-label="KnightFall in competition">
      <img id="closing-image" src="/images/photo_gallery/2026semispirit.avif" alt="KnightFall students supporting the team at competition" width="426" height="640" loading="lazy" decoding="async">
      <div class="closing-number" aria-hidden="true">6901</div>
      <div class="closing-copy reveal">
        <p class="closing-meta">Team archive / 6901</p>
        <h2>More than one robot.</h2>
        <p>See the competitions, outreach, and people behind Team 6901.</p>
        <a href="/pictures" class="btn btn-primary">View team photos <span aria-hidden="true">↗</span></a>
      </div>
    </section>
  </main>

  <script>
    import '@google/model-viewer';
  </script>
  <script is:inline slot="scripts" src="/js/index.js?v=50"></script>
</BaseLayout>
