---
interface Props {
  title: string;
  description?: string;
  keywords?: string;
  currentPage?: 'home' | 'team' | 'pictures' | 'seasons';
}

const {
  title,
  description = '',
  keywords = 'FRC, 6901 KnightFall, Robots, Robotics, STEM',
  currentPage = 'home',
} = Astro.props;

const isTeam = currentPage === 'team';
const isPictures = currentPage === 'pictures';
const teamBase = isTeam ? '' : '/team';
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <meta charset="UTF-8">
  <meta name="theme-color" content="#110d16">
  <meta name="color-scheme" content="dark light">
  <title>{title}</title>
  {description && <meta name="description" content={description}>}
  <meta name="keywords" content={keywords}>
  <script is:inline>
    (() => {
      document.documentElement.classList.add('js');
      try {
        const saved = localStorage.getItem('knightfall-theme');
        const theme = saved || (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        document.documentElement.dataset.theme = theme;
      } catch {
        document.documentElement.dataset.theme = 'dark';
      }
    })();
  </script>
  <link rel="icon" type="image/png" sizes="32x32" href="/images/6901_logos/favicon-google-search.png">
  <link rel="icon" type="image/png" href="/images/6901_logos/favicon-white.png" media="(prefers-color-scheme: dark)">
  <link rel="apple-touch-icon" href="/images/6901_logos/apple-touch-iconSWORD.png">
  <link rel="stylesheet" href="/css/main.css?v=8">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <script src="https://code.iconify.design/3/3.1.1/iconify.min.js"></script>
  <slot name="head" />
</head>
<body class={`page-${currentPage}`}>
  <a class="skip-link" href="#main-content">Skip to main content</a>

  <header class={`site-header${isPictures ? ' scrolled' : ''}`} id="hdr">
    <a href="/" class="header-logo">
      <img src="/images/6901_logos/SwordLogo.png" alt="KnightFall Logo" width="500" height="500">
      KnightFall
    </a>
    <nav class="header-nav" aria-label="Primary navigation">
      <a href={`${teamBase}#about`}>About</a>
      <a href={`${teamBase}#frc`}>FRC</a>
      <a href={`/seasons`}>Seasons</a>
      <a href={`${teamBase}#outreach`}>Outreach</a>
      <a href={`${teamBase}#sponsors`}>Sponsors</a>
      <a href="/pictures">Photos</a>
      <a href={`${teamBase}#contact`}>Contact Us</a>
    </nav>
    <button class="theme-toggle" id="theme-toggle" type="button" aria-label="Use light mode" title="Use light mode">
      <i class="fa-solid fa-sun theme-icon-light" aria-hidden="true"></i>
      <i class="fa-solid fa-moon theme-icon-dark" aria-hidden="true"></i>
    </button>
    <button class="hamburger" id="hamburger" type="button" aria-label="Open navigation" aria-controls="mobile-menu" aria-expanded="false">
      <span aria-hidden="true"></span><span aria-hidden="true"></span><span aria-hidden="true"></span>
    </button>
  </header>

  <nav class="mobile-menu" id="mobile-menu" aria-label="Mobile navigation" aria-hidden="true" inert>
    <a href={`${teamBase}#about`}>About</a>
    <a href={`${teamBase}#frc`}>FRC</a>
    <a href="/seasons">Seasons</a>
    <a href={`${teamBase}#outreach`}>Outreach</a>
    <a href={`${teamBase}#sponsors`}>Sponsors</a>
    <a href="/pictures">Photos</a>
    <a href={`${teamBase}#contact`}>Contact Us</a>
  </nav>

  <div id="main-content" tabindex="-1">
    <slot />
  </div>

  <footer class="site-footer">
    <div class="footer-brand">Knight<span>Fall</span> / FRC 6901</div>
    <nav class="footer-nav" aria-label="Footer navigation">
      <a href="/">Home</a>
      <a href="/team">Team Info</a>
      <a href="/pictures">Photos</a>
      <a href="/team#sponsors">Sponsors</a>
      <a href="/team#packages">Partner With Us</a>
      <a href="/team#contact">Contact Us</a>
    </nav>
    <div class="footer-social">
      <a href="https://www.instagram.com/frc6901/" target="_blank" rel="noopener" aria-label="Instagram">
        <i class="fab fa-instagram"></i>
      </a>
    </div>
    <div class="footer-copy">
      &copy; KnightFall FRC 6901 / Frisco, TX
    </div>
  </footer>

  <script is:inline src="/js/main.js?v=7"></script>
  <slot name="scripts" />

</body>
</html>
