---
import BaseLayout from '../layouts/BaseLayout.astro';
import OutreachCard from '../components/OutreachCard.astro';
import PackageCard from '../components/PackageCard.astro';
import ContactForm from '../components/ContactForm.astro';

const outreachItems = [
  {
    title: 'University of Brasilia — LAMFO',
    description: 'Virtually assisted a college in Brazil through instructional videos on robotic mechanisms and designs, plus an introductory programming lesson — sharing expertise with a global audience.',
    image: '/images/outreach_gallery/LAMFO AND UNIVERSITY OF BRASILLA\'S SEMANA.avif',
    imageAlt: 'University of Brasilia Collaboration',
  },
  {
    title: 'FIRST Lego League Camp',
    description: 'Hosted a camp for elementary and middle schoolers introducing the engineering design process, block coding, and foundational sensor usage — sparking early STEM interest.',
    image: '/images/outreach_gallery/FIRST LEGO LEAGUE CAMP.webp',
    imageAlt: 'FIRST LEGO League Camp',
  },
  {
    title: 'AOPS Virtual Camp',
    description: 'Assisted middle school students with robotics programming in a virtual simulator and engaged them in teamwork through assigned missions — expanding the team\'s educational reach online.',
    image: '/images/outreach_gallery/AOPS VIRTUAL CAMP.avif',
    imageAlt: 'AOPS Virtual Camp',
  },
];

const sponsors = [
  {
    name: 'Boeing',
    logo: '/images/partner_logos/boeing.png',
    description: 'With generous support, Boeing provided critical funding that helped our team grow and compete at higher levels, empowering our students to reach new heights in STEM education.',
    url: 'https://www.boeing.com/',
    tier: 'Prince / Princess',
  },
  {
    name: 'Leidos',
    logo: '/images/partner_logos/leidos.png',
    description: 'Leidos\' sponsorship enabled us to access advanced technology and resources, enhancing our team\'s capabilities and providing invaluable opportunities for our students — a key partner in our journey.',
    url: 'https://www.leidos.com/',
    tier: 'Prince / Princess',
  },
  {
    name: 'Raising Cane\'s',
    logo: '/images/partner_logos/raisingcanes.png',
    description: 'Raising Cane\'s support fueled our team\'s growth and success, providing essential resources that allowed us to compete and thrive in the FIRST Robotics Competition.',
    url: 'https://raisingcanes.com/home/?utm_source=cpc&utm_medium=googleads&utm_term=na&utm_campaign=nmf&gad_source=1&gad_campaignid=19414481723&gbraid=0AAAAApKLZqendOQekNVzHfjMF0kjuIhE0&gclid=CjwKCAjwtcHPBhADEiwAWo3sJqYC7iZ04ZWcPO43wGX9MGYwhuK5anU3RysotlEtaP-ksagJ9Wc9UxoCig0QAvD_BwE',
    tier: 'Squire',
  },
];

const groupedSponsors = sponsors.reduce((acc, sponsor) => {
  if (!acc[sponsor.tier]) acc[sponsor.tier] = [];
  acc[sponsor.tier].push(sponsor);
  return acc;
}, {} as Record<string, typeof sponsors>);

const packages = [
  {
    tier: 'Emperor / Empress',
    amount: '$10,000+',
    benefits: [
      'Large logo on website, t-shirt, robot &amp; competition banner',
      'Up to twelve team t-shirts',
      'Personalized impact video',
      'Video recap after every competition',
      'All King/Queen benefits included',
    ],
  },
  {
    tier: 'King / Queen',
    amount: '$5,000 – $9,999',
    benefits: [
      'Medium logo on website, t-shirt, robot &amp; competition banner',
      'Robot demo at your organization\'s events',
      'All Prince/Princess benefits included',
    ],
  },
  {
    tier: 'Prince / Princess',
    amount: '$2,500 – $4,999',
    benefits: [
      'Medium logo on t-shirt, website &amp; competition banner',
      'Four team t-shirts',
      'All Duke/Duchess benefits included',
    ],
  },
  {
    tier: 'Duke / Duchess',
    amount: '$1,000 – $2,499',
    benefits: [
      'Medium logo on website; small on t-shirt &amp; banner',
      'All Knight benefits included',
    ],
  },
  {
    tier: 'Knight',
    amount: '$500 – $999',
    benefits: [
      'Small logo on t-shirt, website &amp; competition banner',
      'Thank-you team picture',
      'Social media post',
      'All Squire benefits included',
    ],
  },
  {
    tier: 'Squire',
    amount: '$100 – $499',
    benefits: [
      'Your name on our website',
      'Thank-you team letter',
    ],
  },
];
---
<BaseLayout
  title="Team Info — FRC 6901 Knights Robotics"
  description="Learn about FRC 6901 Knights Robotics — our history, seasons, outreach, and sponsorship opportunities."
  keywords="FRC, 6901 Knights, Robots, Robotics, STEM, Frisco TX"
  currentPage="team"
>
  <link slot="head" rel="stylesheet" href="/css/team.css">

  <!-- PAGE HERO -->
  <div class="page-hero" id="home">
    <div class="page-hero-bg"></div>
    <img class="page-hero-photo" src="/images/photo_gallery/teampic.avif" alt="">
    <div class="page-hero-inner">
      <div class="page-eyebrow">FRC Team 6901</div>
      <h1 class="page-title">The<br><em>Team</em></h1>
      <p class="page-desc">Knights Robotics is a non-profit <strong>FIRST Robotics Competition</strong> team in Frisco, TX — founded in 2018 to inspire the next generation of STEM leaders.</p>
    </div>
  </div>

  <!-- ABOUT -->
  <section id="about" class="alt">
    <div class="two-col">
      <div>
        <div class="section-label reveal">About Us</div>
        <h2 class="section-heading reveal delay-1">Built for<br><em>Students</em></h2>
        <p class="body-text reveal delay-2">
          Welcome to <strong>Knights Robotics!</strong> We’re a team of high school students who turn big ideas into a real, functioning robot.
          <span class="spacer"></span>
          Students develop technical skills including <strong>CAD, programming, and machining</strong>, alongside teamwork, problem-solving, and leadership through subteams and community events.
          <span class="spacer"></span>
          Founded in 2018, we have competed across Texas and qualified for the <strong>FRC World Championship</strong> during the Deep Space season.
        </p>
        <blockquote class="pull-quote reveal delay-3">
          "More than robots — we build engineers, communicators, and collaborators."
        </blockquote>
      </div>
      <div class="photo-frame reveal-right">
        <img src="/images/photo_gallery/teampic.avif" alt="Knights Robotics Team 2023">
      </div>
    </div>
  </section>

  <!-- ABOUT FRC -->
  <section id="frc" class="default">
    <div class="two-col">
      <div class="photo-frame reveal-left">
        <img src="/images/partner_logos/FRCLogo.svg" alt="FRC Competition">
      </div>
      <div>
        <div class="section-label reveal">About FRC</div>
        <h2 class="section-heading reveal delay-1">The<br><em>Competition</em></h2>
        <p class="body-text reveal delay-2" style="font-size:18px; font-weight:400; color:#bbb; font-style:italic; margin-bottom:1.5rem; line-height:1.55;">
          "The World's Leading Youth-Serving Nonprofit Advancing STEM Education"
        </p>
        <p class="body-text reveal delay-2">
          Combining the excitement of sport with the rigors of science and technology, FIRST Robotics Competition is the ultimate Sport for the Mind. High-school participants call it "the hardest fun you'll ever have."
          <span class="spacer"></span>
          Under strict rules and limited time, teams design, fund, and build industrial-size robots to play a difficult field game each season. Volunteer professional mentors also guide each team towards their season's goals.
          <span class="spacer"></span>
          <strong><a href="https://www.firstinspires.org/" target="_blank" rel="noopener">More at firstinspires.org &rarr;</a></strong>
        </p>
      </div>
    </div>
  </section>

  <!-- SEASONS -->
  <section id="seasons" class="alt">
    <div class="timeline-wrap">
      <div class="section-label reveal">Our History</div>
      <h2 class="section-heading reveal delay-1">Recent<br><em>Seasons</em></h2>

      <div class="timeline seasons-preview">

        <div class="t-item">
          <div class="t-dot"></div>
          <div class="t-year">2026</div>
          <div class="t-body">
            <div class="t-season">Rebuilt</div>
            <span class="iconify t-icon" data-icon="qlementine-icons:wall-16"></span>
            <div class="t-name">Reaching New Heights</div>
            <p class="t-desc">This season was a major leap forward for our team, starting with the Fort Worth District Event, where we ranked 21st, and finished with a strong quarterfinals game. From there, we went on to win 2nd place at the Manor District Competition, and won the Gracious Professionalism and District Finalist Award. This earned us a exciting spot at the Texas State Championship held in Houston, where we finished at rank 23 out of 45. Although we did not make playoffs, we improved and learned so much this season. </p>
          </div>
        </div>

        <div class="t-item">
          <div class="t-dot"></div>
          <div class="t-year">2025</div>
          <div class="t-body">
            <div class="t-season">Reefscape</div>
            <span class="iconify t-icon" data-icon="fluent-emoji-high-contrast:coral"></span>
            <div class="t-name">Game Changer</div>
            <p class="t-desc">This year, the Knights Robotics team participated in two events: FIT Belton and FIT Fort Worth. In Belton, we ranked 15 out of 41, winning 6 games, losing 5 games, and getting a tie for 1 game, however we did not get picked during alliance selections. In Fort Worth, we performed much better. We were 10th out of 35 people, getting 7 wins and 5 losses. During the qualification matches, we beat the record for the most amount of points scored, with a score of 189. We were also the alliance captain for alliance 8. Additionally, we were the recipient of the Rising All-Star Award. Our performance at the FIT Fort Worth District event was unparalleled, but unfortunately, we were unable to move onto the next level. Despite this, we learned more than we ever had, and we were ready to make next year the best one yet.</p>
          </div>
        </div>

        <div class="t-item">
          <div class="t-dot"></div>
          <div class="t-year">2024</div>
          <div class="t-body">
            <div class="t-season">Crescendo</div>
            <span class="iconify t-icon" data-icon="fluent-mdl2:volume-3"></span>
            <div class="t-name">Resilience in Competition</div>
            <p class="t-desc">This year, we competed in two events: FIRST In Texas Plano Event, and FIRST In Texas Dallas Event. With only freshmen and sophomores, this season proved to be challenging for us because of our lack of knowledge. In the Plano event, we placed 20 out of 29, winning 4 games and losing 8 games. Despite this, we fortunately got chosen in round 2 of Alliance 4. In the Dallas event, we ended with a ranking of 20 out of 43, with 5 wins and 7 losses. Unfortunately, we did not get chosen during alliance selection. Despite the undesirable outcomes this season, we still prevailed, and we ended the season with more knowledge than what we started with, and we also built relationships with new teams and mentors.</p>
          </div>
        </div>

      </div>

      <div style="text-align:center; margin-top:3rem;" class="reveal">
        <a href="/seasons" class="btn btn-primary">
          <i class="fa-solid fa-history"></i> View All Seasons
        </a>
        <a href="/pictures" class="btn btn-ghost">
          <i class="fa-regular fa-images"></i> View Photo Gallery
        </a>
      </div>
    </div>
  </section>

  <!-- OUTREACH -->
  <section id="outreach" class="default">
    <div class="section-label reveal" style="justify-content:center;">Community</div>
    <h2 class="section-heading reveal delay-1" style="text-align:center; max-width:600px; margin:0 auto 1.5rem;">Outreach</h2>
    <p class="outreach-intro reveal delay-2">
      Team 6901 is dedicated to providing STEM educational opportunities for students of all ages — from elementary to college level — with a focus on practical robotics.
    </p>
    <div class="outreach-grid">
      {outreachItems.map((item, i) => (
        <OutreachCard
          title={item.title}
          description={item.description}
          image={item.image}
          imageAlt={item.imageAlt}
          delay={i > 0 ? `delay-${i}` as any : undefined}
        />
      ))}
    </div>
  </section>

  <!-- CURRENT SPONSORS -->
  <section id="sponsors" class="alt">
    <div class="section-label reveal" style="justify-content:center;">Partners</div>
    <h2 class="section-heading reveal delay-1" style="text-align:center; max-width:600px; margin:0 auto 1.5rem;">Current<br><em>Sponsors</em></h2>
    <p class="section-intro reveal delay-2" style="text-align:center;">
      We're grateful to the organizations that have provided financial contributions and equipment to make our team's work possible.
    </p>
    {
      Object.entries(groupedSponsors).map(([tier, tierSponsors], tierIndex) => (
        <div class="tier-section">
          <h3 class={`tier-heading reveal ${tierIndex > 0 ? 'tier-heading-margin' : ''}`} style="text-align: center; margin: 2rem 0 1rem;">{tier}</h3>
          <ul class="sponsors-list">
            {tierSponsors.map((s, i) => (
              <li class={`sponsor-item reveal ${i > 0 ? `delay-${Math.min(i, 3)}` : ''}`}>
                <div class="sponsor-content">
                  <a href={s.url} target="_blank" rel="noopener" class="sponsor-logo-link">
                    <img src={s.logo} alt={s.name} class="sponsor-logo">
                  </a>
                  <div class="sponsor-details">
                    <a href={s.url} target="_blank" rel="noopener" class="sponsor-name">
                      {s.name}
                    </a>
                    <p class="sponsor-description">{s.description}</p>
                  </div>
                </div>
              </li>
            ))}
          </ul>
        </div>
      ))
    }
  </section>

  <!-- SPONSORSHIP PACKAGES -->
  <section id="packages" class="default">
    <div class="section-label reveal" style="justify-content:center;">Sponsorship</div>
    <h2 class="section-heading reveal delay-1" style="text-align:center; max-width:700px; margin:0 auto 1.5rem;">Partnership<br><em>Packages</em></h2>
    <p class="section-intro reveal delay-2" style="text-align:center; margin-bottom:3.5rem;">
      By supporting our nonprofit team, your company makes a positive impact on STEM education in the Frisco, TX community — inspiring the next generation of engineers and innovators.
    </p>

    <div class="pkg-grid">
      {packages.map((pkg, i) => (
        <PackageCard
          tier={pkg.tier}
          amount={pkg.amount}
          benefits={pkg.benefits}
          delay={[1, 2, undefined, 1, 2, undefined][i] ? `delay-${[1, 2, undefined, 1, 2, undefined][i]}` as any : undefined}
        />
      ))}
    </div>

    <div class="roi-grid reveal">
      <div class="roi-block">
        <h3>Social Return on Investment</h3>
        <p>Your support increases our budget and enables better facilities and more team members. Frisco students gain access to engineering, business, and programming pathways through FIRST Robotics — expanding STEM education and encouraging future careers in innovation. Sponsorship also enables us to host FRC tournaments and STEM camps, amplifying both your company's and FIRST's reach in the community.</p>
      </div>
      <div class="roi-block">
        <h3>Benefits of Sponsoring</h3>
        <ul>
          <li>Promote practical STEM applications in Frisco, TX</li>
          <li>Tax-deductible donation — 501(c)(3) organization</li>
          <li>Mentoring opportunities for your professionals</li>
          <li>Intern and employee recruiting pipeline</li>
          <li>Website and competition webcast visibility</li>
        </ul>
      </div>
    </div>
  </section>

  <!-- CTA -->
  <section class="cta-section alt" id="join">
    <div class="section-label reveal" style="justify-content:center;">Get Involved</div>
    <h2 class="section-heading reveal delay-1">Ready to<br><em>Build?</em></h2>
    <p class="cta-sub reveal delay-2">Whether you're a student, mentor, or potential sponsor — there's a place for you on Knights Robotics.</p>
    <div class="cta-row reveal delay-3">
      <a href="https://www.instagram.com/frc6901/" target="_blank" rel="noopener" class="btn btn-primary">
        <i class="fab fa-instagram"></i> Follow on Instagram
      </a>
      <a href="/pictures" class="btn btn-ghost">
        <i class="fa-regular fa-images"></i> View Photos
      </a>
    </div>
  </section>

  <ContactForm />

  <script is:inline slot="scripts" src="/js/team.js"></script>
</BaseLayout>
