---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArrowIcon from '../components/ArrowIcon.astro';

const sponsors = [
  { name: 'Boeing', logo: '/images/partner_logos/boeing-color.png', width: 300, height: 110 },
  { name: 'Leidos', logo: '/images/partner_logos/leidos-color.svg', width: 331, height: 78 },
  { name: 'Dallas College', logo: '/images/partner_logos/dallascollege.png', width: 640, height: 207 },
  { name: "Raising Cane's", logo: '/images/partner_logos/raisingcanes.png', width: 769, height: 325 },
];
---

<BaseLayout
  title="KnightFall FRC 6901 | Student-Built Robotics"
  description="Meet KnightFall FRC Team 6901, a student-built robotics team, and learn how to join or support the team in Frisco, Texas."
  keywords="FRC, 6901 KnightFall, robotics, STEM, Frisco Texas, student robotics"
  currentPage="home"
>
  <link slot="head" rel="stylesheet" href="/css/index.css?v=68">

  <div class="site-loader" id="site-loader" role="status" aria-live="polite" aria-label="Loading KnightFall">
    <div class="loader-signature">
      <div class="loader-mark" aria-hidden="true">
        <svg class="loader-mark-drawing" viewBox="0 0 500 500" aria-hidden="true">
          <defs>
            <mask id="loader-sword-strokes" maskUnits="userSpaceOnUse" x="0" y="0" width="500" height="500" style="mask-type: alpha">
              <g fill="none" stroke="white" stroke-width="36" stroke-linecap="round" stroke-linejoin="round">
                <path class="loader-ink" pathLength="1" d="M250 20 281 51 250 82 219 51 250 20Z" />
                <path class="loader-ink loader-ink-stem" pathLength="1" d="M250 82V137M212 137H288" />
                <path class="loader-ink loader-ink-guard" pathLength="1" d="M168 136 192 176H228M332 136 308 176H271" />
                <path class="loader-ink loader-ink-blade" pathLength="1" d="M228 176 211 214 294 383 250 477 208 383 233 327" />
                <path class="loader-ink loader-ink-ribbon" pathLength="1" d="M271 176 289 214 268 257" />
              </g>
            </mask>
          </defs>
          <image class="loader-sword" href="/images/6901_logos/SwordLogo.png" width="500" height="500" mask="url(#loader-sword-strokes)" />
        </svg>
      </div>
      <div class="loader-type">
        <p class="loader-wordmark" aria-hidden="true"><span class="loader-knight">Knight</span><span class="loader-fall">Fall</span></p>
        <p class="loader-status">FRC Team 6901</p>
      </div>
    </div>
  </div>

  <!-- Direction: a cinematic engineering portfolio. Oversized type sets the scale,
       real photographs make the story human. -->
  <main>
    <section class="home-hero" aria-labelledby="home-title">
      <div class="hero-copy" id="hero-copy">
        <div class="hero-topline"><p>FRC 6901 · Frisco, Texas</p></div>
        <p class="hero-brand">KnightFall</p>
        <div class="hero-intro">
          <h1 id="home-title">Built by students.<br><span class="hero-accent">Ready for the field.</span></h1>
          <p class="hero-summary">A high school robotics team developing creative thinkers, problem-solvers, and future leaders through STEM.</p>
          <div class="hero-actions">
            <a href="/team" class="btn btn-primary">Meet KnightFall <ArrowIcon /></a>
            <a href="https://www.instagram.com/frc6901/" target="_blank" rel="noopener" class="hero-social">Instagram <ArrowIcon /></a>
          </div>
        </div>
      </div>
    </section>

    <section class="join-section" id="join" aria-labelledby="join-title">
      <div class="section-rule"><span>01 / THE PEOPLE</span><span>Our team, at work.</span></div>
      <div class="join-heading reveal">
        <p class="chapter-index">Built for students</p>
        <h2 id="join-title">Find your place<br>in the <em>build.</em></h2>
      </div>
      <div class="join-copy reveal">
        <p>Some of us start with CAD. Others start with code, a tool, or a question. On KnightFall, we learn by working on the robot together.</p>
        <a href="/team#contact" class="btn btn-ghost">Talk with the team <ArrowIcon /></a>
      </div>
      <div class="join-worktable" aria-label="Student opportunities">
        <figure class="worktable-photo worktable-photo-main reveal">
          <img src="/images/photo_gallery/robot2.webp" alt="A KnightFall student programming the robot beside its exposed wiring and aluminum frame" width="1584" height="2112" loading="lazy" decoding="async">
          <figcaption>Working on the robot.</figcaption>
        </figure>
        <div class="worktable-note reveal">
          <p>You don’t have to<br>know it all.<br><em>Start here.</em></p>
          <a href="/team#about">Get to know the team <ArrowIcon /></a>
        </div>
        <figure class="worktable-photo worktable-photo-detail reveal">
          <img src="/images/photo_gallery/programming.avif" alt="KnightFall students working together on robot code" width="640" height="427" loading="lazy" decoding="async">
          <figcaption>Working through the code.</figcaption>
        </figure>
        <figure class="worktable-photo worktable-photo-build reveal">
          <img src="/images/photo_gallery/2026pitcrew.avif" alt="KnightFall students working together in the competition pit" width="426" height="640" loading="lazy" decoding="async">
          <figcaption>In the competition pit.</figcaption>
        </figure>
      </div>
      <ul class="discipline-list" id="student-paths" aria-label="Ways students contribute">
        <li><details><summary><span>01</span>Design and CAD<span class="discipline-toggle" aria-hidden="true">+</span></summary><p>Figure out how the parts fit together in CAD before we make them.</p></details></li>
        <li><details><summary><span>02</span>Fabrication<span class="discipline-toggle" aria-hidden="true">+</span></summary><p>Learn to machine parts, assemble mechanisms, and work with the tools in the shop.</p></details></li>
        <li><details><summary><span>03</span>Programming<span class="discipline-toggle" aria-hidden="true">+</span></summary><p>Write robot code, test it on the hardware, and work through what needs fixing.</p></details></li>
        <li><details><summary><span>04</span>Drive and strategy<span class="discipline-toggle" aria-hidden="true">+</span></summary><p>Practice driving, study matches, and plan how we can work with our alliance.</p></details></li>
      </ul>
    </section>

    <section class="proof-moment" aria-labelledby="proof-title">
      <div class="proof-image">
        <img src="/images/photo_gallery/web/2026match2.webp" alt="KnightFall's 6901 robot competing on the 2026 field, with game pieces in the air" width="1600" height="1066" loading="lazy" decoding="async">
      </div>
      <div class="proof-copy">
        <p class="chapter-index">02 / ON THE FIELD</p>
        <h2 id="proof-title" class="reveal">Then it’s<br><em>match time.</em></h2>
        <div class="proof-caption"><span>From the shop to the field.</span><a href="/seasons">Explore our seasons <ArrowIcon /></a></div>
      </div>
    </section>
    <section class="field-record" aria-labelledby="record-title">
      <div><p class="chapter-index" id="record-title">Our team so far</p><p>Competing in FIRST Robotics<br>since 2018.</p></div>
      <dl class="proof-facts">
        <div class="reveal"><dt>2018</dt><dd>Team founded</dd></div>
        <div class="reveal delay-1"><dt>Worlds</dt><dd>Championship qualifier</dd></div>
        <div class="reveal delay-2"><dt>Texas</dt><dd>State championship competitor</dd></div>
      </dl>
    </section>

    <section class="sponsor-section" id="sponsors" aria-labelledby="sponsor-title">
      <div class="section-rule"><span>03 / OUR PARTNERS</span><span>Thank you for supporting our team.</span></div>
      <div class="sponsor-intro reveal">
        <p class="chapter-index">Current partners</p>
        <h2 id="sponsor-title">Behind<br>the <em>build.</em></h2>
      </div>
      <div class="sponsor-copy reveal">
        <h3>Support the next build.</h3>
        <p>Our sponsors help pay for parts, tools, and travel to competitions. Their support keeps us building and gives more students a chance to take part.</p>
        <a href="/team#packages" class="btn btn-ghost">View partnership packages <ArrowIcon /></a>
      </div>
      <div class="sponsor-ribbon" aria-label="KnightFall sponsors">
        {sponsors.map((sponsor) => (
          <a class="home-sponsor reveal" href="/team#sponsors" aria-label={`About our sponsor, ${sponsor.name}`}>
            <img src={sponsor.logo} alt={sponsor.name} width={sponsor.width} height={sponsor.height} loading="lazy" decoding="async">
          </a>
        ))}
      </div>
    </section>

    <section class="closing-photo" aria-labelledby="closing-title">
      <img id="closing-image" src="/images/photo_gallery/team.webp" alt="KnightFall students gathered around their competition robot" width="1600" height="1205" loading="lazy" decoding="async">
      <div class="closing-copy">
        <p class="closing-meta">THE PEOPLE BEHIND 6901</p>
        <h2 id="closing-title" class="reveal">More than<br>one robot.</h2>
        <p>See the competitions, outreach, and people behind Team 6901.</p>
        <a href="/pictures" class="btn btn-primary">View team photos <ArrowIcon /></a>
      </div>
    </section>
  </main>
  <script is:inline slot="scripts" src="/js/index.js?v=67"></script>
</BaseLayout>
