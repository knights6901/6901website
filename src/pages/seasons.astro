---
import BaseLayout from '../layouts/BaseLayout.astro';

const seasons = [
  {
    year: 2026,
    name: 'Rebuilt',
    title: 'Reaching New Heights',
    description: 'This season was a major leap forward for our team, starting with the Fort Worth District Event, where we ranked 21st, and finished with a strong quarterfinals game. From there, we went on to win 2nd place at the Manor District Competition, and won the Gracious Professionalism and District Finalist Award. This earned us a exciting spot at the Texas State Championship held in Houston, where we finished at rank 23 out of 45. Although we did not make playoffs, we improved and learned so much this season.',
    icon: 'qlementine-icons:wall-16',
  },
  {
    year: 2025,
    name: 'Reefscape',
    title: 'Game Changer',
    description: 'This year, KnightFall participated in two events: FIT Belton and FIT Fort Worth. In Belton, we ranked 15 out of 41, winning 6 games, losing 5 games, and getting a tie for 1 game, however we did not get picked during alliance selections. In Fort Worth, we performed much better. We were 10th out of 35 people, getting 7 wins and 5 losses. During the qualification matches, we beat the record for the most amount of points scored, with a score of 189. We were also the alliance captain for alliance 8. Additionally, we were the recipient of the Rising All-Star Award. Our performance at the FIT Fort Worth District event was unparalleled, but unfortunately, we were unable to move onto the next level. Despite this, we learned more than we ever had, and we were ready to make next year the best one yet.',
    icon: 'solar:cup-star-linear',
  },
  {
    year: 2024,
    name: 'Crescendo',
    title: 'Resilience in Competition',
    description: 'This year, we competed in two events: FIRST In Texas Plano Event, and FIRST In Texas Dallas Event. With only freshmen and sophomores, this season proved to be challenging for us because of our lack of knowledge. In the Plano event, we placed 20 out of 29, winning 4 games and losing 8 games. Despite this, we fortunately got chosen in round 2 of Alliance 4. In the Dallas event, we ended with a ranking of 20 out of 43, with 5 wins and 7 losses. Unfortunately, we did not get chosen during alliance selection. Despite the undesirable outcomes this season, we still prevailed, and we ended the season with more knowledge than what we started with, and we also built relationships with new teams and mentors.',
    icon: 'solar:music-note-2-linear',
    },
  {
    year: 2023,
    name: 'Charged Up',
    title: 'Exceeding Expectations',
    description: 'KnightFall had a remarkable season, securing 12th place in their first game and achieving their best performance with a 3rd place finish, a 10-5-0 record, and the Team Sustainability Award in their second game. They even exceeded expectations by qualifying for the state tournament. Qualifying for the state tournament was an unexpected and exciting achievement for KnightFall, as it was not their initial goal for the season. Though their performance at state was not ideal, the team\'s hard work and dedication were evident throughout the season, culminating in impressive achievements. KnightFall proved to be a talented and hardworking group of individuals who worked together to achieve success and make unforgettable memories.',
    icon: 'bi:lightning-charge',
  },
  {
    year: 2022,
    name: 'Rapid React',
    title: 'Competitive Growth',
    description: 'The 2022 competitive season was astonishing. We competed in two districts: FIT District Fort Worth Event and FIT District Irving Event. At Fort Worth, we were able to Rank 20 and make it to the quarterfinals before leaving. Although we didn\'t do our best in the Fort Worth District, things changed at the Irving District. While ranking 33rd and winning the District Event Finalist awards, we were able to conquer quarterfinals and semifinals and make it to the finals. While playing with and against the top Texas teams, such as Team 118 Robonauts, Team 148 Robowranglers, and Team 3310 Black Hawk Robotics, we were able to leave with plenty of knowledge and end our season.',
    icon: 'uil:plane-fly',
  },
  {
    year: 2021,
    name: 'Virtual Challenge',
    title: 'A Season That Went Online',
    description: 'Given the ongoing coronavirus pandemic and the need for social distancing measures, FIRST offered three virtual competitions for teams to participate in. Our team took advantage of these chances and participated in the FIRST Game Design Challenge as well as the FIRST Innovation Challenge sponsored by Qualcomm. These two challenges gave our team a fun and interesting way to connect and get to know one another, despite being in a virtual and remote environment. In the FIRST Game Design Challenge, our team was honored with the Engineering Design Award in recognition of our methodical engineering design approach in building the game field. This achievement makes us happy to share this news.',
    icon: 'mi:computer',
  },
  {
    year: 2020,
    name: 'Infinite Recharge',
    title: 'Making the Most of a Short Season',
    description: 'Our season was regrettably cut short by the unanticipated events brought on by the coronavirus pandemic. However, our team was determined to capitalize on the circumstance and took advantage of the chance to sharpen our focus on teamwork. We were fortunate enough to compete at one conference despite the cancellation of other events. In response to these difficulties, our team actively sought out chances to work with other institutions and universities, using online tools to develop educational programs that expose kids and college students to the basics of robotics.',
    icon: 'iconoir:ev-charge',
  },
  {
    year: 2019,
    name: 'Deep Space',
    title: 'A Milestone Season',
    description: 'We delivered a standout performance this season, placing 8th in Plano and 5th in Dallas while taking home both the Innovation in Control and Quality Awards. Our performance continued at the District Championships in Austin, where we reached the quarterfinals and secured a spot at the FIRST Championship in Houston, marking a huge achievement for the team. This historic run not only tested our technical skills but also proved that our program can compete with the best teams in the world.',
    icon: 'hugeicons:moon-01',
  },
  {
    year: 2018,
    name: 'Power Up',
    title: 'Founding Season',
    description: 'Starting our rookie season meant building our entire knowledge base from the ground up. While we faced some tough first-year challenges, we proved our potential by placing 34th out of 60 teams at the Dallas District Competition. This experience was about more than just the rank; it allowed us to establish a solid foundation and a real sense of team spirit. We\'ve learned exactly what it takes to compete, and we walked away with the skills needed to push even further!',
    icon: 'clarity:battery-line',
  },
];
---
<BaseLayout
  title="All Seasons — FRC 6901 Knights Robotics"
  description="Explore all FRC seasons of Team 6901 KnightFall from 2018 to present."
  keywords="FRC, 6901 Knights, Seasons, History, Robotics"
  currentPage="seasons"
>
  <link slot="head" rel="stylesheet" href="/css/seasons.css?v=1">

  <div class="seasons-page">
    <!-- PAGE HERO -->
    <div class="seasons-hero" id="home">
      <img class="seasons-hero-photo" src="/images/photo_gallery/2026teampic.avif" alt="">
      <div class="seasons-hero-inner">
        <div class="seasons-eyebrow">FRC Team 6901</div>
        <h1 class="seasons-title">All<br><em>Seasons</em></h1>
        <p class="seasons-desc">From our founding in 2018 to the present day, explore the complete history of KnightFall.</p>
      </div>
    </div>

    <!-- SEASONS -->
    <section class="seasons-archive" id="seasons" aria-labelledby="seasons-heading">
      <div class="seasons-timeline-wrap">
        <p class="seasons-index" id="seasons-heading">Competition archive / 2018—present</p>

        <div class="seasons-timeline">
        {seasons.map((season) => (
          <article class="season-entry">
            <div class="season-year">{season.year}</div>
            <div class="season-marker" aria-hidden="true"></div>
            <div class="season-body">
              <div class="season-game">{season.name}</div>
              <div class="season-title-row">
                <span class="iconify season-icon" data-icon={season.icon} aria-hidden="true"></span>
                <h2 class="season-title">{season.title}</h2>
              </div>
              <p class="season-description">{season.description}</p>
            </div>
          </article>
        ))}
        </div>

        <div class="seasons-return reveal">
          <a href="/team#seasons" class="btn btn-ghost">
            <i class="fa-solid fa-arrow-left"></i> Back to Team Info
          </a>
        </div>
      </div>
    </section>
  </div>

  <script is:inline slot="scripts" src="/js/seasons.js?v=1"></script>
</BaseLayout>
