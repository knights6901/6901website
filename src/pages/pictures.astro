---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout
  title="Photos — FRC 6901 Knights Robotics"
  description="Photo gallery from FRC 6901 Knights Robotics — seasons, competitions, and memories."
  currentPage="pictures"
>
  <link slot="head" rel="stylesheet" href="/css/pictures.css">

  <!-- PAGE HERO -->
  <div class="page-hero">
    <div class="page-hero-bg"></div>
    <div class="page-hero-inner">
      <div class="page-eyebrow">Gallery</div>
      <h1 class="page-title">Achievements<br>& <em>Memories</em></h1>
      <p class="page-desc">A look back at the seasons, competitions, and moments that define Knights Robotics.</p>
    </div>
  </div>

  <!-- FILTER BAR -->
  <div class="filter-bar">
    <button class="filter-btn active" data-year="all"     onclick="filterGallery('all', this)">All Photos</button>
    <button class="filter-btn"        data-year="2026" onclick="filterGallery('2026', this)">2026 Season</button>
    <button class="filter-btn"        data-year="2023"    onclick="filterGallery('2023', this)">2023 Season</button>
    <button class="filter-btn"        data-year="history" onclick="filterGallery('history', this)">2018 – 2022</button>
    
  </div>

  <!-- GALLERY (populated by JS) -->
  <div class="gallery-section">
    <div class="gallery-grid" id="gallery-grid"></div>
  </div>

  <!-- LIGHTBOX -->
  <div class="lightbox" id="lightbox" role="dialog" aria-modal="true" aria-label="Photo lightbox">
    <button class="lb-close" onclick="closeLightbox()" aria-label="Close">&times;</button>
    <button class="lb-nav lb-prev" onclick="navLightbox(-1)" aria-label="Previous">&#8592;</button>
    <img class="lb-img" id="lb-img" src="" alt="">
    <button class="lb-nav lb-next" onclick="navLightbox(1)"  aria-label="Next">&#8594;</button>
    <div class="lb-caption" id="lb-caption"></div>
    <div class="lb-count"   id="lb-count"></div>
  </div>

  <script is:inline slot="scripts" src="/js/pictures.js"></script>
</BaseLayout>
