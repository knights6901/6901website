---
import BaseLayout from '../layouts/BaseLayout.astro';

const seasons = [
  {
    year: 2026,
    name: 'Rebuilt',
    title: 'A remarkable season — 3rd place finish, 10-5-0 record',
    description: 'Secured 12th place in the first event, then achieved a 3rd place finish and earned the Team Sustainability Award. Unexpectedly qualified for the state tournament — a proud milestone. Though state was tough, the team\'s dedication shone all season.',
    icon: '<svg class="t-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 2v6h-6M3 22v-6h6M2 11.5a10 10 0 0 1 18.8-4.3M22 12.5a10 10 0 0 1-18.8 2.2"/></svg>',
  },
  {
    year: 2025,
    name: 'Reefscape',
    title: 'Game Changer',
    description: 'This year, the Knights Robotics team participated in two events: FIT Belton and FIT Fort Worth. In Belton, we ranked 15 out of 41, winning 6 games, losing 5 games, and getting a tie for 1 game, however we did not get picked during alliance selections. In Fort Worth, we performed much better. We were 10th out of 35 people, getting 7 wins and 5 losses. During the qualification matches, we beat the record for the most amount of points scored, with a score of 189. We were also the alliance captain for alliance 8. Additionally, we were the recipient of the Rising All-Star Award. Our performance at the FIT Fort Worth District event was unparalleled, but unfortunately, we were unable to move onto the next level. Despite this, we learned more than we ever had, and we were ready to make next year the best one yet.',
    icon: '<svg class="t-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7v5c0 5.55 3.84 10.74 9 12 5.16-1.26 9-6.45 9-12V7l-10-5z"/><path d="M12 8v8M8 12h8"/></svg>',
  },
  {
    year: 2024,
    name: 'Crescendo',
    title: 'Resilience in Competition',
    description: 'This year, we competed in two events: FIRST In Texas Plano Event, and FIRST In Texas Dallas Event. With only freshmen and sophomores, this season proved to be challenging for us because of our lack of knowledge. In the Plano event, we placed 20 out of 29, winning 4 games and losing 8 games. Despite this, we fortunately got chosen in round 2 of Alliance 4. In the Dallas event, we ended with a ranking of 20 out of 43, with 5 wins and 7 losses. Unfortunately, we did not get chosen during alliance selection. Despite the undesirable outcomes this season, we still prevailed, and we ended the season with more knowledge than what we started with, and we also built relationships with new teams and mentors.',
    icon: '<svg class="t-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v20M12 2l-6 6M12 2l6 6M12 22l-6-6M12 22l6-6"/><circle cx="12" cy="12" r="3"/></svg>',
  },
  {
    year: 2023,
    name: 'Charged Up',
    title: 'Exceeding Expectations',
    description: 'The Knights Robotics team had a remarkable season, securing 12th place in their first game and achieving their best performance with a 3rd place finish, a 10-5-0 record, and the Team Sustainability Award in their second game. They even exceeded expectations by qualifying for the state tournament. Qualifying for the state tournament was an unexpected and exciting achievement for the Knights Robotics team, as it was not their initial goal for the season. Though their performance at state was not ideal, the team\'s hard work and dedication were evident throughout the season, culminating in impressive achievements. The Knights Robotics team proved to be a talented and hardworking group of individuals who worked together to achieve success and make unforgettable memories.',
    icon: '<svg class="t-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2v6M12 16v6M5 9h14M5 15h14M7 9L3 5M17 9l4-4M7 15L3 19M17 15l4 4"/></svg>',
  },
  {
    year: 2022,
    name: 'Rapid React',
    title: 'Competitive Growth',
    description: 'The 2022 competitive season was astonishing. We competed in two districts: FIT District Fort Worth Event and FIT District Irving Event. At Fort Worth, we were able to Rank 20 and make it to the quarterfinals before leaving. Although we didn\'t do our best in the Fort Worth District, things changed at the Irving District. While ranking 33rd and winning the District Event Finalist awards, we were able to conquer quarterfinals and semifinals and make it to the finals. While playing with and against the top Texas teams, such as Team 118 Robonauts, Team 148 Robowranglers, and Team 3310 Black Hawk Robotics, we were able to leave with plenty of knowledge and end our season.',
    icon: '<svg class="t-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M13 2L3 14h9l-1 8 10-12h-9l1-8z"/></svg>',
  },
  {
    year: 2021,
    name: 'Virtual Challenge',
    title: 'A Season That Went Online',
    description: 'Given the ongoing coronavirus pandemic and the need for social distancing measures, FIRST offered three virtual competitions for teams to participate in. Our team took advantage of these chances and participated in the FIRST Game Design Challenge as well as the FIRST Innovation Challenge sponsored by Qualcomm. These two challenges gave our team a fun and interesting way to connect and get to know one another, despite being in a virtual and remote environment. In the FIRST Game Design Challenge, our team was honored with the Engineering Design Award in recognition of our methodical engineering design approach in building the game field. This achievement makes us happy to share this news.',
    icon: '<svg class="t-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/><line x1="8" y1="21" x2="16" y2="21"/><line x1="12" y1="17" x2="12" y2="21"/><circle cx="12" cy="10" r="3"/><path d="M6 6l2 2M18 6l-2 2"/></svg>',
  },
  {
    year: 2020,
    name: 'Infinite Recharge',
    title: 'Making the Most of a Short Season',
    description: 'Our season was regrettably cut short by the unanticipated events brought on by the coronavirus pandemic. However, our team was determined to capitalize on the circumstance and took advantage of the chance to sharpen our focus on teamwork. We were fortunate enough to compete at one conference despite the cancellation of other events. In response to these difficulties, our team actively sought out chances to work with other institutions and universities, using online tools to develop educational programs that expose kids and college students to the basics of robotics.',
    icon: '<svg class="t-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>',
  },
  {
    year: 2019,
    name: 'Deep Space',
    title: 'A Milestone Season',
    description: 'We delivered a standout performance this season, placing 8th in Plano and 5th in Dallas while taking home both the Innovation in Control and Quality Awards. Our performance continued at the District Championships in Austin, where we reached the quarterfinals and secured a spot at the FIRST Championship in Houston, marking a huge achievement for the team. This historic run not only tested our technical skills but also proved that our program can compete with the best teams in the world.',
    icon: '<svg class="t-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><path d="M12 6v6l4 2"/><path d="M8 4l3-3 5 5M16 8l3-3-5 5"/></svg>',
  },
  {
    year: 2018,
    name: 'Power Up',
    title: 'Founding season',
    description: 'Starting our rookie season from scratch meant building our entire knowledge base from the ground up. While we faced some tough firstyear challenges, we proved our potential by placing 34th out of 60 teams at the Dallas District Competition. This experience was about more than just the rank; it allowed us to establish a solid foundation and a real sense of team spirit. We\'ve learned exactly what it takes to compete, and we walked away with the skills needed to push even further!',
    icon: '<svg class="t-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polygon points="12 2 2 7 2 17 12 22 22 17 22 7 12 2"/><line x1="12" y1="12" x2="12" y2="22"/><line x1="12" y1="12" x2="2" y2="7"/><line x1="12" y1="12" x2="22" y2="7"/></svg>',
  },
];
---
<BaseLayout
  title="All Seasons — FRC 6901 Knights Robotics"
  description="Explore all FRC seasons of Team 6901 Knights Robotics from 2018 to present."
  keywords="FRC, 6901 Knights, Seasons, History, Robotics"
  currentPage="team"
>
  <link slot="head" rel="stylesheet" href="/css/team.css">

  <!-- PAGE HERO -->
  <div class="page-hero" id="home">
    <div class="page-hero-bg"></div>
    <img class="page-hero-photo" src="/images/teampic.avif" alt="">
    <div class="page-hero-inner">
      <div class="page-eyebrow">FRC Team 6901</div>
      <h1 class="page-title">All<br><em>Seasons</em></h1>
      <p class="page-desc">From our founding in 2018 to the present day, explore the complete history of Knights Robotics.</p>
    </div>
  </div>

  <!-- SEASONS -->
  <section id="seasons">
    <div class="timeline-wrap">
    
      <div class="timeline">
        {seasons.map((season, i) => (
          <div class="t-item">
            <div class="t-dot"></div>
            <div class="t-year">{season.year}</div>
            <div class="t-body">
              <div class="t-season">{season.name}</div>
              <Fragment set:html={season.icon} />
              <div class="t-name">{season.title}</div>
              <p class="t-desc">{season.description}</p>
            </div>
          </div>
        ))}
      </div>

      <div style="text-align:center; margin-top:3rem;" class="reveal">
        <a href="/team#seasons" class="btn btn-ghost">
          <i class="fa-solid fa-arrow-left"></i> Back to Team Info
        </a>
      </div>
    </div>
  </section>

  <script is:inline slot="scripts" src="/js/team.js"></script>
</BaseLayout>
